# Add these non-secret process variables to the API's environment when reviewing the feature.
# The ordinary MVP launch keeps the media endpoint disabled.
API_MEDIA_ENABLED=true
API_MEDIA_AUTO_DISCOVERY_ENABLED=true
API_MEDIA_LOOKUP_TIMEOUT=12s
API_MEDIA_CONNECT_TIMEOUT=2s
API_MEDIA_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
API_MEDIA_WIKIDATA_URL=https://www.wikidata.org/w/api.php
API_MEDIA_COMMONS_URL=https://commons.wikimedia.org/w/api.php
API_MEDIA_USER_AGENT=trego/0.1 (contact: https://github.com/uksus148/trego./issues)
# Optional replacement reviewed local catalog; never use a remote URL.
# API_MEDIA_CATALOG=file:/absolute/path/to/reviewed-catalog.json
